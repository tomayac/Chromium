// https://wicg.github.io/cross-origin-storage/#the-crossoriginstoragemanager-interface

dictionary CrossOriginStorageRequestFileHandleOptions {
    boolean create = false;

    // Omitted means same-site origins only. "*" means any origin, subject to
    // availability gating. A (possibly empty) sequence means exactly those
    // origins. Note that an explicit empty sequence is a real, empty list --
    // it is not equivalent to omitting the member.
    (DOMString or sequence<DOMString>) origins;
};
